# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# In Vercel: add these under Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# REQUIRED for security — set a strong password to protect the dashboard.
# Anyone who visits the URL will be asked for this password.
# If left empty, the dashboard is open to everyone (not recommended for production).
DASHBOARD_PASSWORD=change-me-to-a-strong-password

# Optional: Vercel KV — for persistent storage across serverless restarts.
# Without this, records reset on each cold start (fine for testing, not ideal for production).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
